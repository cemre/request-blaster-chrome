{
  "manifest_version": 3,
  "name": "Request Blaster",
  "description": "Triage Instagram follow requests in bulk (e.g. accept everyone with N+ mutuals) – advanced controls to /blast/ through your queue.",
  "version": "1.5",
  "minimum_chrome_version": "114",

  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png"
  },

  "permissions": [ "sidePanel", "storage", "tabs", "scripting", "downloads", "downloads.ui" ],

  "host_permissions": [ "*://*.instagram.com/*" ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [{
    "js": [ "content.js", "banner.js", "harvest-content.js", "anon-content.js" ],
    "matches": [ "*://*.instagram.com/*" ],
    "run_at": "document_idle",
    "all_frames": false
  }],

  "web_accessible_resources": [{
    "resources": [ "src/alias.js" ],
    "matches": [ "*://*.instagram.com/*" ]
  }],

  "action": {
    "default_title": "Request Blaster",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
